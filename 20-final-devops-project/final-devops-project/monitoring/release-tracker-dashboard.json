{
  "title": "Release Tracker",
  "uid": "release-tracker",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Requests per second",
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(release_tracker_http_requests_total[5m]))", "legendFormat": "requests/s"}]
    },
    {
      "type": "timeseries",
      "title": "Request latency p95",
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(release_tracker_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}]
    },
    {
      "type": "timeseries",
      "title": "Responses by status",
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [{"expr": "sum(rate(release_tracker_http_requests_total[5m])) by (status)", "legendFormat": "{{status}}"}]
    }
  ]
}
