      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum(up)", "refId": "A"}],
      "title": "Healthy scrape targets",
      "type": "stat"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 8},
      "id": 5,
