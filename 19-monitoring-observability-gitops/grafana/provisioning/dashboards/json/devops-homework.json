      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "refId": "A"}],
      "title": "Container CPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(container_memory_working_set_bytes{name!=\"\"})", "refId": "A"}],
      "title": "Container memory working set",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "UNHEALTHY"}, "1": {"color": "green", "text": "HEALTHY"}}, "type": "value"}]}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "devops_homework_demo_health", "refId": "A"}],
      "title": "Application health",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
